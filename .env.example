# Copy this file to .env and fill in what you have. Everything is optional:
# without keys you can still drop files into media/raw and media/music by hand.

# Tella: Workspace settings -> API keys
TELLA_API_KEY=
TELLA_API_BASE=https://api.tella.com/v1

# Epidemic Sound Partner API (developers.epidemicsound.com). Only needed for
# `vedit music search/pull`. A normal Epidemic Sound subscription works fine
# too: download the track from the website and put it in media/music/.
EPIDEMIC_ACCESS_KEY_ID=
EPIDEMIC_ACCESS_KEY_SECRET=
EPIDEMIC_API_BASE=https://partner-content-api.epidemicsound.com
