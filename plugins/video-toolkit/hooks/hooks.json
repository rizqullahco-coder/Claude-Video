{
  "description": "Checks ffmpeg is installed at session start and stops ffmpeg from overwriting its own input file.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-ffmpeg.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-ffmpeg.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
